#!/usr/bin/env bash
# wr — braindead launcher. Builds automatically, then does the thing.
#
#   ./wr              do EVERYTHING: build, test, benchmark
#   ./wr 6x6          find one 6×6 rectangle   (also: ./wr 5x7, ./wr 4)
#   ./wr count 3x3    count all 3×3 rectangles
#   ./wr test         run the tests
#   ./wr bench        run the benchmark suite (add B1/B2/B3 for just one)
#   ./wr release      benchmark with the full release build (official numbers)
#   ./wr info         words per length in the dictionary
set -euo pipefail
cd "$(dirname "$0")"

BIN=target/fast/wordrect
build() { cargo build --quiet --profile fast; }

# "6x6" -> "--rows 6 --cols 6" ; "6" -> 6x6
size() {
  local s="${1:-}"
  [[ $s =~ ^[0-9]+$ ]] && s="${s}x${s}"
  [[ $s =~ ^([0-9]+)x([0-9]+)$ ]] || { echo "size must look like 6x6 or 6 (got '$s')"; exit 1; }
  echo "--rows ${BASH_REMATCH[1]} --cols ${BASH_REMATCH[2]}"
}

cmd="${1:-all}"
case "$cmd" in
  all)
    echo "▶ build";  build
    echo "▶ test";   cargo test --quiet 2>&1 | grep -E "test result|FAILED|panicked" | grep -v " 0 passed"
    echo "▶ bench";  scripts/bench.sh
    ;;
  test)    cargo test --quiet ;;
  bench)   shift; scripts/bench.sh "$@" ;;
  release) shift; scripts/bench.sh --release "$@" ;;
  info)    build; $BIN info ;;
  count)   build; $BIN count $(size "${2:-}") --stats "${@:3}" ;;
  find)    build; $BIN find  $(size "${2:-}") --stats "${@:3}" ;;
  help|-h|--help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)       build; $BIN find $(size "$cmd") --stats "${@:2}" ;;   # ./wr 6x6
esac
